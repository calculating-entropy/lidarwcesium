# Frontend Environment Configuration
# Copy this file to .env.local and adjust values as needed

# API URL - change this based on your deployment environment
# For local development with backend on port 8000:
# REACT_APP_API_URL=http://localhost:8000
# For production with API proxy:
REACT_APP_API_URL=/api

# Other environment-specific settings can be added here
REACT_APP_ENVIRONMENT=development
